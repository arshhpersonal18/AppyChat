rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      // Subcollection: Contacts
      match /contacts/{contactId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Subcollection: Call Logs
      match /call_logs/{logId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid || resource.data.targetUid == request.auth.uid
      );
    }

    // Chat Rooms and Messages
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }

      match /typing/{userId} {
        allow read, write: if isSignedIn();
      }
    }

    // WebRTC Calls
    match /calls/{callId} {
      allow read, write: if isSignedIn();
    }
  }
}
